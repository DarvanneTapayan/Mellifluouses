{
  "entities": {
    "VideoProject": {
      "title": "Video Project",
      "description": "A project in the video portfolio",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Project title" },
        "description": { "type": "string", "description": "Detailed description" },
        "thumbnail": { "type": "string", "description": "Thumbnail image URL" },
        "videoUrl": { "type": "string", "description": "Video player/embed URL" },
        "category": { "type": "string", "enum": ["Cinematic", "Experimental", "Product"] },
        "createdAt": { "type": "object", "description": "Server timestamp" }
      },
      "required": ["title", "thumbnail", "videoUrl", "category"]
    },
    "Testimony": {
      "title": "Testimonial",
      "description": "Client testimonial",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Client name" },
        "role": { "type": "string", "description": "Client role" },
        "content": { "type": "string", "description": "Testimonial content" },
        "avatar": { "type": "string", "description": "Client avatar URL" },
        "createdAt": { "type": "object", "description": "Server timestamp" }
      },
      "required": ["name", "content"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "VideoProject",
      "description": "Collection of video projects"
    },
    "/testimonials/{testimonyId}": {
      "schema": "Testimony",
      "description": "Collection of client testimonials"
    }
  }
}
